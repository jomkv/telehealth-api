// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  birthday     DateTime
  profilePic   String?
  mobileNumber String
  role         Role
  isOnboarded  Boolean  @default(false)
  createdAt    DateTime @default(now())

  patient Patient?
  doctor  Doctor?
}

enum Role {
  PATIENT
  DOCTOR
}

model Specialization {
  id          String @id @default(uuid())
  label       String @unique
  description String
  embedding   Json // Float[] stored as JSON, populated at seed time

  doctors Doctor[]
}

model Patient {
  id          String   @id @default(uuid())
  userId      String   @unique
  weight      Float
  height      Float
  conditions  String[]
  allergies   String[]
  medications String[]
  notes       String?

  user          User           @relation(fields: [userId], references: [id])
  consultations Consultation[]
}

model Doctor {
  id               String  @id @default(uuid())
  userId           String  @unique
  specializationId String
  bio              String?
  yearsOfPractice  Int?

  consultations Consultation[]
  availability  AvailabilityTemplate[]

  user           User           @relation(fields: [userId], references: [id])
  specialization Specialization @relation(fields: [specializationId], references: [id])
}

model AvailabilityTemplate {
  id        String    @id @default(uuid())
  doctorId  String
  dayOfWeek DayOfWeek
  startTime String // "09:00", hourly intervals, no minutes
  endTime   String // "17:00", hourly intervals, no minutes

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek])
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Consultation {
  id              String    @id @default(uuid())
  patientId       String
  doctorId        String
  scheduledAt     DateTime
  meetingLink     String
  patientNotes    String // symptoms/concerns at booking time
  doctorNotes     String? // post-consultation notes / directions, initially empty (will be filled later by doctor)
  rescheduledFrom DateTime?
  createdAt       DateTime  @default(now())

  status ConsultationStatus @default(PENDING)

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
}

enum ConsultationStatus {
  PENDING
  ONGOING
  DONE
  CANCELLED
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
